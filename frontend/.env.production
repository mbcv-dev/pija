# Build de produção (Vercel).
#
# Estes são os valores REAIS de produção, não placeholders. Antes ficava
# VITE_USE_MOCK=true aqui e só a variável do painel da Vercel salvava o deploy —
# o que funciona (no Vite, `process.env` do build sobrescreve o .env), mas deixa
# o repositório com um default que, se a variável do painel sumisse, faria o
# dashboard renderizar dados FALSOS em produção sem erro nenhum. Um build errado
# apontando para o backend errado se percebe; um build servindo mock não.
VITE_USE_MOCK=false
VITE_API_BASE_URL=https://pija-backend-production.up.railway.app
