# Variáveis de ambiente do frontend PIJA
# Copie este arquivo para .env.local (dev) ou configure no painel da Vercel (produção).

# ------------------------------------------------------------
# MODO MOCK
# true  → usa dados simulados (sem backend)
# false → consome a API real definida em VITE_API_BASE_URL
# ------------------------------------------------------------
VITE_USE_MOCK=false

# ------------------------------------------------------------
# URL BASE DO BACKEND (obrigatório quando VITE_USE_MOCK=false)
# Exemplo Railway: https://pija-back-production.up.railway.app
# Sem barra no final.
# ------------------------------------------------------------
VITE_API_BASE_URL=https://<sua-url-do-railway>
