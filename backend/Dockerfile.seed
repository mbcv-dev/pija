FROM python:3.11-slim

WORKDIR /app
RUN pip install --no-cache-dir \
    "pydantic>=2.8" "pydantic-settings>=2.4" "sqlalchemy[asyncio]>=2.0" \
    "aiosqlite>=0.20" "pandas>=2.2" "PyYAML>=6.0"

COPY src/ ./src/
ENV PYTHONPATH=/app/src

# Os 6 CSVs do HC ficam em backend/seed-csv/ (gitignored).
# Coloque os arquivos lá antes de buildar esta imagem.
# Build: docker build -f Dockerfile.seed -t pija-back:seed .
# (usar .dockerignore.seed que NÃO exclui seed-csv/)
COPY seed-csv/ /seed-csv/

# Caminhos alinhados ao runner (settings.csv_dir / settings.sqlite_path).
# Default correto-por-padrão — não precisa setar no painel.
ENV CSV_DIR=/seed-csv
ENV SQLITE_PATH=/data/pija.db
VOLUME ["/data"]

# Lê CSVs de /seed-csv, escreve pija.db no volume /data e termina.
CMD ["python", "-m", "pija.etl.runner"]
